{
  "name": "now",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",

      "Shared": {
        "$className": "Folder",
        "Config": { "$path": "src/shared/Config.lua" }
      },

      "Events": { "$path": "src/shared/Events/Events.model.json" }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Main": { "$path": "src/server/Main.server.lua" }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Main": { "$path": "src/client/Main.client.lua" }
      }
    }
  }
}
